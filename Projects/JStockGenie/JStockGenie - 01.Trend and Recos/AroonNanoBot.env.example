# Copy this file to AroonNanoBot.env and keep the copy private.
# Do not commit or paste credentials into chat.

# NinjaTrader environment and links
NINJATRADER_ENVIRONMENT=DEMO
NINJATRADER_WEB_URL=https://web-trader.ninjatrader.com/workspace
NINJATRADER_API_BASE_URL=https://demo.tradovateapi.com/v1
NINJATRADER_MARKET_DATA_BASE_URL=wss://md-demo.tradovateapi.com/v1/websocket

# Credentials and account settings: fill locally, never in chat.
NINJATRADER_USERNAME=
NINJATRADER_PASSWORD=
NINJATRADER_CLIENT_ID=
NINJATRADER_CLIENT_SECRET=
NINJATRADER_ACCOUNT_ID=
NINJATRADER_ACCOUNT_SPEC=

# Runtime authentication token is short-lived; do not persist it in source control.
NINJATRADER_ACCESS_TOKEN=

# Bot scope: nano contracts only.
AROON_SYMBOLS=NES DEC26,NNQ DEC26
AROON_TIMEFRAME=DAILY
AROON_PERIOD=14
AROON_TIMEZONE=America/Chicago

# Safety defaults.
PAPER_ONLY=true
LIVE_TRADING_ENABLED=false
MAX_CONTRACTS_PER_SYMBOL=1
ALLOW_SHORT=false
FLATTEN_BEFORE_SESSION_CLOSE=true
REQUIRE_COMPLETED_BAR=true
REJECT_DELAYED_DATA=true
